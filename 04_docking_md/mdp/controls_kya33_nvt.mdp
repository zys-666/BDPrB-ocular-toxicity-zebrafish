; nvt.mdp - 500 ps NVT equilibration with position restraints
define                  = -DPOSRES -DPOSRES_LIG
integrator              = md
dt                      = 0.002
nsteps                  = 250000

nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstenergy               = 1000
nstlog                  = 1000
nstxout-compressed      = 5000
compressed-x-grps       = System

continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
DispCorr                = EnerPres

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1    0.1
ref_t                   = 310    310

pcoupl                  = no

gen_vel                 = yes
gen_temp                = 310
gen_seed                = -1
