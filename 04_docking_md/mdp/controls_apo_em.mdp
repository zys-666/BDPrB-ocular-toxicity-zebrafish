; em.mdp - energy minimisation
integrator      = steep
nsteps          = 20000
emtol           = 1000.0
emstep          = 0.01

cutoff-scheme   = Verlet
nstlist         = 20
pbc             = xyz
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
dispcorr        = enerpres

nstenergy       = 100
nstlog          = 100
